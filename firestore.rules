rules_version = '2';

// Herkese açık içerik GitHub Pages'te; Firestore'da yalnızca kullanıcıya özel veriler var.
// users/{uid}             profil ve takip listesi
// users/{uid}/veri/okundu okundu işaretleri { ids: { "<kayıt>": zaman }, guncelleme }
// Burada eşleşmeyen her yol (başka koleksiyonlar, listeleme) varsayılan olarak reddedilir.
service cloud.firestore {
  match /databases/{database}/documents {

    // E-postası doğrulanmış (e-posta bağlantısıyla girişte otomatik) ya da telefonla giriş yapmış kullanıcı.
    // E-posta/şifre sağlayıcısı API üzerinden şifreli hesap açmaya izin verdiği için doğrulanmamış hesaplar dışarıda.
    function dogrulanmis() {
      return request.auth != null
        && (request.auth.token.get('email_verified', false) == true
            || request.auth.token.get('phone_number', null) != null);
    }

    function sahibi(uid) {
      return dogrulanmis() && request.auth.uid == uid;
    }

    function liste(t, ad, enFazla) {
      return !(ad in t) || (t[ad] is list && t[ad].size() <= enFazla);
    }

    function gecerliTakip(t) {
      return t is map
        && t.keys().hasOnly(['mv', 'parti', 'iller', 'kelime', 'konular'])
        && liste(t, 'mv', 300) && liste(t, 'parti', 30) && liste(t, 'iller', 81)
        && liste(t, 'kelime', 50) && liste(t, 'konular', 20);
    }

    // Bildirim planı: bilgi türleri, sıklık ve sessiz saatler
    function gecerliTercih(p) {
      return p is map
        && p.keys().hasOnly(['turler', 'ritim', 'sessiz'])
        && (!('ritim' in p) || p.ritim in ['yakindan', 'gunluk', 'haftalik'])
        && (!('turler' in p) || (p.turler is map && p.turler.keys().hasOnly(['oylama', 'ozet', 'konusma', 'teklif'])))
        && (!('sessiz' in p) || (p.sessiz is map && p.sessiz.keys().hasOnly(['bas', 'bit'])));
    }

    function metinYaDaBos(d, ad) {
      return d.get(ad, null) == null || d[ad] is string;
    }

    function gecerliKullanici(d) {
      return d.keys().hasOnly(['eposta', 'telefon', 'olusturma', 'guncelleme', 'takip', 'tercih', 'riza'])
        && metinYaDaBos(d, 'eposta') && metinYaDaBos(d, 'telefon')
        && (!('takip' in d) || gecerliTakip(d.takip))
        && (!('tercih' in d) || gecerliTercih(d.tercih));
    }

    // Açık rıza kaydı: hangi metne, ne zaman (sunucu saati) verildiği
    function gecerliRiza(r) {
      return r is map && r.keys().hasOnly(['metin', 'zaman']) && r.metin is string && r.metin.size() <= 60
        && r.zaman == request.time;
    }

    match /users/{uid} {
      // Yalnızca tek belge okunabilir; koleksiyonu listelemek (başkalarının kayıtlarını görmek) kapalı
      allow get, delete: if sahibi(uid);

      // E-posta/telefon giriş kimliğiyle aynı olmalı; oluşturma zamanı sunucudan gelmeli
      allow create: if sahibi(uid)
        && gecerliKullanici(request.resource.data)
        && request.resource.data.get('eposta', null) == request.auth.token.get('email', null)
        && request.resource.data.get('telefon', null) == request.auth.token.get('phone_number', null)
        && request.resource.data.olusturma == request.time
        && !('guncelleme' in request.resource.data)
        // Takip listesi sunucuya ancak açık rızayla gelir: oluştururken rıza kaydı zorunlu
        && gecerliRiza(request.resource.data.riza);

      // Güncellemede yalnızca takip listesi ve bildirim planı değişebilir; e-posta, telefon, oluşturma zamanı ve rıza sabit
      allow update: if sahibi(uid)
        && gecerliKullanici(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['takip', 'tercih', 'guncelleme'])
        && request.resource.data.guncelleme == request.time;

      match /veri/{belge} {
        allow get, delete: if sahibi(uid);
        allow create, update: if sahibi(uid) && belge == 'okundu'
          && request.resource.data.keys().hasOnly(['ids', 'guncelleme'])
          && request.resource.data.ids is map && request.resource.data.ids.size() <= 20000
          && request.resource.data.guncelleme == request.time;
      }
    }
  }
}
